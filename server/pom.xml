<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.14</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.moyz</groupId>
    <artifactId>aideepin</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>aideepin</name>
    <description>Chat,Draw,RAG,Workflow,MCP marketplace</description>
    <modules>
        <module>adi-common</module>
        <!-- OPT-15 批 1（已收口 S1-04）：过渡聚合层 adi-common-biz 已逐域搬出并删除
             （aspects->adi-common，BeanConfig/Jobs/Initializer->adi-bootstrap，embedding 实现->adi-chat-core） -->
        <!-- OPT-15 批 2：draw 域试点模块 -->
        <module>adi-draw</module>
        <!-- OPT-15 批 3：模型与工具接入域（languagemodel + AiModel/MCP/ExtApi/Credential 系） -->
        <module>adi-model</module>
        <!-- OPT-15 批 4：知识库与 RAG 检索域（rag/ + Kb*/Document*/Rag*/SegmentIndex/IndexTask/Ocr 系） -->
        <module>adi-kb-rag</module>
        <!-- OPT-15 批 5：对话核心域（Character*/memory/finetune/multiagent + User/Prompt/Scene/Skill 系） -->
        <module>adi-chat-core</module>
        <!-- OPT-15 批 6：工作流域（workflow/ 引擎+节点 + Workflow*/Wf* 服务 + 触发基础设施 + AiAgentService） -->
        <module>adi-workflow</module>
        <module>adi-chat</module>
        <module>adi-bootstrap</module>
        <module>adi-integration-test</module>
        <module>adi-admin</module>
    </modules>

    <repositories>
        <repository>
            <id>project-local-repo</id>
            <url>file://${maven.multiModuleProjectDirectory}/local-repo</url>
        </repository>
    </repositories>
    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <langchain4j.version>1.14.1</langchain4j.version>
        <shedlock.version>5.16.0</shedlock.version>
        <!-- OPT-14: community 线上游恒为 -betaN（无 GA），属性名去掉临时前缀、语义定版；
             隔离执行见 dependencyManagement 注释（随 OPT-15 域拆分收敛） -->
        <langchain4j-community.version>1.14.1-beta24</langchain4j-community.version>
        <langgraph4j.version>1.8.15</langgraph4j.version>
    </properties>

    <!--
        OPT-10（2026-10-23）依赖治理：父 pom 原 <dependencies> 41 项全量迁入 dependencyManagement，
        父 pom 不再向子模块强制下发任何依赖；各子模块按 import 扫描的真实使用显式声明（version 由本段单点管理）。
        目的：可从子 pom 判断模块真实依赖、classpath 收缩，为 adi-common 按域拆分（OPT-15）提供可约束的依赖方向。
        行为不变性说明：零 import 的 commons-text / antlr4-runtime 保留在 adi-common（原父 pom 会下发到全部模块的
        classpath，为防运行时反射加载风险按"最终 classpath 不变"原则声明在 adi-common）；
        mysql-connector-j（无 import，仅 JDBC 运行时驱动）移至唯一可运行模块 adi-bootstrap（runtime scope）。
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                注意：spring-boot 系列 starter / lombok / postgresql / aspectjweaver /
                jackson-datatype-jsr310 / mysql-connector-j 之外的 spring 托管坐标
                均由 spring-boot-starter-parent 托管版本，此处不再重声明——
                在本段重声明而不带 version 会遮蔽上游托管版本导致构建失败。
            -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>3.5.12</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-jsqlparser</artifactId>
                <version>3.5.12</version>
            </dependency>
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.4.8-jre</version>
            </dependency>
            <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.0.33</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <!-- OPT-12（2026-10-24）：2.1.0 与 Spring Boot 3.5 不兼容（ControllerAdviceBean
                     构造器 NoSuchMethodError，/v3/api-docs 500），升 2.8 线适配 Boot 3.5 -->
                <version>2.8.9</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-collections4</artifactId>
                <version>4.4</version>
            </dependency>
            <dependency>
                <groupId>com.talanlabs</groupId>
                <artifactId>avatar-generator-cat</artifactId>
                <version>1.1.0</version>
            </dependency>
            <dependency>
                <groupId>org.mindrot</groupId>
                <artifactId>jbcrypt</artifactId>
                <version>0.4</version>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-generator</artifactId>
                <version>3.5.3.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.velocity</groupId>
                <artifactId>velocity-engine-core</artifactId>
                <version>2.3</version>
            </dependency>
            <dependency>
                <groupId>org.mapdb</groupId>
                <artifactId>mapdb</artifactId>
                <version>3.0.9</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.jetbrains.kotlin</groupId>
                        <artifactId>kotlin-stdlib</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <!--
                langchain4j BOM 托管坐标（core 全家桶：starter/mcp/pgvector/embeddings/parsers/
                ollama/jsoup/google-custom/http-client-jdk 等）不在本段重声明——
                重声明不带 version 会遮蔽 BOM；子模块无 version 引用即可从 langchain4j-bom 解析。
                仅 BOM 外的 community 三件套在此固定 langchain4j-community.version。
                OPT-14（2026-10-24）：langchain4j-community 线上游恒为 -betaN 后缀、无正式版可转正
                （Maven Central 实查 dashscope 线无 GA 版本号），按方案走"隔离"路径——三个 beta 依赖
                随 OPT-15 域拆分收敛进 adi-kb-rag(rag 存储) / adi-model(dashscope) 域模块，
                主链路 classpath 只保留实际使用的域。
            -->
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-community-dashscope</artifactId>
                <version>${langchain4j-community.version}</version>
            </dependency>
            <dependency>
                <groupId>org.antlr</groupId>
                <artifactId>antlr4-runtime</artifactId>
                <version>4.12.0</version>
            </dependency>
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-text</artifactId>
                <version>1.10.0</version>
            </dependency>
            <dependency>
                <groupId>cn.hutool</groupId>
                <artifactId>hutool-core</artifactId>
                <version>5.8.33</version>
            </dependency>
            <dependency>
                <groupId>com.aliyun.oss</groupId>
                <artifactId>aliyun-sdk-oss</artifactId>
                <version>3.18.1</version>
            </dependency>
            <dependency>
                <groupId>org.apache.httpcomponents</groupId>
                <artifactId>httpmime</artifactId>
                <version>4.5.14</version>
            </dependency>
            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-core</artifactId>
                <version>${langgraph4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.bsc.langgraph4j</groupId>
                <artifactId>langgraph4j-langchain4j</artifactId>
                <version>${langgraph4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ws.schild</groupId>
                <artifactId>jave-all-deps</artifactId>
                <version>3.5.0</version>
            </dependency>
            <!-- S1-07a：ShedLock 定时任务防重（多实例共库部署时 @Scheduled 不重复执行） -->
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>
