# Glob API URL
VITE_GLOB_API_URL=/api

VITE_APP_API_BASE_URL=http://127.0.0.1:9999/

# Whether long replies are supported, which may result in higher API fees
VITE_GLOB_OPEN_LONG_REPLY=false

# When you want to use PWA
# T9-11：默认开启；静态资源 cache-first（hash 文件名），/api 一律 network-only 不缓存
VITE_GLOB_APP_PWA=true

# 注册是否启用邮箱验证码 | Whether registration uses an email verification code
# false(默认): 图形验证码 + 激活邮件链接（原流程）
# true: 注册时发邮箱验证码并校验，通过即激活账号
# 后端开关 adi.register.email-code.enable 必须同步为 true，否则接口会报错
VITE_REGISTER_EMAIL_CODE=true
