# user-web 环境变量模板
# 复制为 .env 后按环境修改；真实环境配置不入库（见 .gitignore）

# 后端 API 相对路径
VITE_GLOB_API_URL=/api

# 后端 API 基础地址（占位符）
VITE_APP_API_BASE_URL=http://127.0.0.1:9999/

# 是否支持长回复（可能产生更高 API 费用）
VITE_GLOB_OPEN_LONG_REPLY=false

# 是否启用 PWA
VITE_GLOB_APP_PWA=false

# 注册是否启用邮箱验证码（需后端 adi.register.email-code.enable 同步为 true）
VITE_REGISTER_EMAIL_CODE=true
