# port
VITE_PORT = 1003

# spa-title
VITE_GLOB_APP_TITLE = AISelf Admin

# spa shortname
VITE_GLOB_APP_SHORT_NAME = AdminPro

# 是否启用 PWA（T9-11）：生产构建生成 manifest/service worker；开发环境不生效
# 缓存策略：静态资源 cache-first（hash 文件名），/api 一律 network-only 不缓存
VITE_GLOB_APP_PWA = true

# 前台站点地址（登录页「去 AISelf」链接）
VITE_GLOB_SITE_URL = http://localhost:1002

# 生产环境 开启mock
VITE_GLOB_PROD_MOCK = true
