# admin-web 环境变量模板
# 复制为 .env / .env.development / .env.production 后按环境修改；真实环境配置不入库（见 .gitignore）

# 开发服务器端口
VITE_PORT = 1003

# 应用标题 / 短名
VITE_GLOB_APP_TITLE = AISelf Admin
VITE_GLOB_APP_SHORT_NAME = AdminPro

# 前台站点地址（登录页跳转链接，占位符）
VITE_GLOB_SITE_URL = http://127.0.0.1:1002

# 生产环境是否开启 mock
VITE_GLOB_PROD_MOCK = true

# 资源公共路径（需以 / 开头和结尾）
VITE_PUBLIC_PATH = /

# 网站前缀
VITE_BASE_URL = /

# 是否开启 mock
VITE_USE_MOCK = false

# 是否删除 console
VITE_DROP_CONSOLE = true

# 跨域代理（占位符，指向本地后端）
VITE_PROXY = [["/api","http://127.0.0.1:9999"]]

# 接口地址
VITE_GLOB_API_URL = /api

# 图片上传地址 / 图片前缀
VITE_GLOB_UPLOAD_URL =
VITE_GLOB_IMG_URL =

# 接口地址前缀
VITE_GLOB_API_URL_PREFIX =

# 构建压缩：gzip | brotli | none
VITE_BUILD_COMPRESS = 'none'
VITE_BUILD_COMPRESS_DELETE_ORIGIN_FILE = false
