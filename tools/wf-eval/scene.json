{
  "scenes": [
    {
      "key": "expense",
      "name": "报销助手",
      "workflows": [
        {
          "key": "travel_expense",
          "title": "差旅报销提交",
          "remark": "提交差旅费用报销单并发起财务审批",
          "inputs": [
            { "name": "amount", "type": "number", "title": "报销金额", "required": true },
            { "name": "department", "type": "text", "title": "所属部门", "required": true },
            { "name": "trip_city", "type": "text", "title": "出差城市", "required": false }
          ]
        },
        {
          "key": "weekly_report",
          "title": "周报生成",
          "remark": "汇总指定周期的工作内容生成周报草稿",
          "inputs": [
            { "name": "period", "type": "text", "title": "周期", "required": true },
            { "name": "highlights", "type": "text", "title": "本周亮点", "required": false }
          ]
        },
        {
          "key": "contract_query",
          "title": "合同审批查询",
          "remark": "查询指定合同的当前审批进度与节点",
          "inputs": [
            { "name": "contract_no", "type": "text", "title": "合同编号", "required": true }
          ]
        }
      ]
    }
  ]
}
